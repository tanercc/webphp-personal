Options -Indexes -ExecCGI
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "sandbox; default-src 'none'; img-src 'self' data:; style-src 'unsafe-inline'; frame-ancestors 'self'"
</IfModule>

# Legacy active documents remain downloadable without running in the site's origin.
<FilesMatch "(?i)\.(?:html?|xhtml|xml|xsl|xslt|js|mjs|css)$">
    ForceType text/plain
    <IfModule mod_headers.c>
        Header always set Content-Disposition "attachment"
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)\.(?:php[0-9]*|phtml|pht|phar|cgi|pl|py|sh|shtml)(?:\.|$)">
    Require all denied
</FilesMatch>
